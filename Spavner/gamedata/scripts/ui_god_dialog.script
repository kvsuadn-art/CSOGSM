-- Описание
function god_dialog:OnBtnShowDescr()
    self.descWndVisible = not self.descWndVisible
    self.descWnd:Show(self.descWndVisible)

    local st = db.storage[db.actor:id()]
    if st then
        if type(st.pstor) ~= "table" then st.pstor = {} end
        st.pstor["descWndVisible"] = self.descWndVisible
    end
end

-- Отключить динамическую погоду
function god_dialog:OnCheck_wt_clicked()
    if not db.actor then return end

    local disable_dynamic = self.wt_cb:GetCheck()

    god.save_var("weather_state", disable_dynamic)

    local last_weather = god.load_var("god_weather_type", "default")

    if disable_dynamic then
        level.set_weather(last_weather, false)
    else
        level.set_weather(last_weather, true)
    end
end

-- Остановить (муз)
function god_dialog:OnButton_music_stop_clicked()
  if db.actor then
    local s =  ui_god_dialog.last_music
    if s~=nil then
      s:stop()
      ui_god_dialog.last_music = nil
    end
  end
end

