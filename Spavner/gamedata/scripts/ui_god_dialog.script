function god_dialog:OnButton_time_plus_clicked()
	if db.actor then
		local tebP = tonumber(self.teb:GetText())
		if tebP ~= nil then
			if tebP < 0 then tebP = 0 end
			t = xr_logic.pstor_retrieve(db.actor, "t", 0)
			t = t + tebP
			level.set_time_factor(t)
			xr_logic.pstor_store(db.actor, "t", t)
			news_manager.send_tip(db.actor, "%c[25,240,25,25]Таймфактор увеличен до "..t.."", nil, nil, 2000)

		    self:RefreshTimeFactorDisplay()
		else
			local snd1 = sound_object([[detectors\contact_2]])
			snd1:play(db.actor, 0, sound_object.s2d)
		end
	end
end

function OnButton_time_normal_clicked()
	level.set_time_factor(10)
	xr_logic.pstor_store(db.actor, "t", 0)
	news_manager.send_tip(db.actor, "%c[0,0,255,25]Таймфактор стандартный", nil, nil, 2000)
end

function OnButton_time_minus_clicked()
	t = xr_logic.pstor_retrieve(db.actor, "t", 0)
	t = t - k
	if t <= 0 then
		OnButton_time_normal_clicked()
	else
		level.set_time_factor (t)
		xr_logic.pstor_store(db.actor, "t", t)
		news_manager.send_tip(db.actor, "%c[255,240,155,25]Таймфактор уменьшен до "..t.."", nil, nil, 2000)
	end	
end

--Стандартное время
function god_dialog:OnButton_time_normal_clicked()
    if db.actor then
        OnButton_time_normal_clicked()   
        time_factor = 10                 
        self:RefreshTimeFactorDisplay()
    end
end

--Ускорить время
function god_dialog:OnButton_time_plus_clicked()
    if db.actor then
        local tebP = tonumber(self.teb:GetText())
        if tebP ~= nil then
            if tebP < 0 then tebP = 0 end

            t = xr_logic.pstor_retrieve(db.actor, "t", 0)
            t = t + tebP
            level.set_time_factor(t)
            xr_logic.pstor_store(db.actor, "t", t)
            news_manager.send_tip(db.actor, "%c[25,240,25,25]Таймфактор увеличен до "..t.."", nil, nil, 2000)

            time_factor = t                 
            self:RefreshTimeFactorDisplay()
        else
            local snd1 = sound_object([[detectors\contact_2]])
            snd1:play(db.actor, 0, sound_object.s2d)
        end
    end
end

--Замедлить время
function god_dialog:OnButton_time_minus_clicked()
    if db.actor then
        local tebM = tonumber(self.teb:GetText())
        if tebM ~= nil then
            if tebM < 0 then tebM = 0 end

            t = xr_logic.pstor_retrieve(db.actor, "t", 0)
            t = t - tebM
            if t <= 0 then
                OnButton_time_normal_clicked()
                time_factor = 10                 
                self:RefreshTimeFactorDisplay() 
            else
                level.set_time_factor(t)
                xr_logic.pstor_store(db.actor, "t", t)
                news_manager.send_tip(db.actor, "%c[255,240,155,25]Таймфактор уменьшен до "..t.."", nil, nil, 2000)

                time_factor = t                
                self:RefreshTimeFactorDisplay() 
            end
        else
            local snd1 = sound_object([[detectors\contact_2]])
            snd1:play(db.actor, 0, sound_object.s2d)
        end
    end
end

