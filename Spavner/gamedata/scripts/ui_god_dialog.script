--//Ранг
---------------
-- Добавить Ранг
function god_dialog:rank_add_clicked()
    if not db.actor then return end

    local edit_box = self:GetEditBox("rank_edit_box")
    local text = edit_box:GetText()
    local val = tonumber(text)

    if val == nil then
        local snd1 = sound_object([[detectors\contact_2]])
        snd1:play(db.actor, 0, sound_object.s2d)
        return
    end

    local current_rank = db.actor:character_rank()

    local new_rank = current_rank + val
    if new_rank < 0 then new_rank = 0 end

    db.actor:set_character_rank(new_rank)
    news_manager.send_tip(db.actor, "Увеличен ранг на: " .. val .. " (текущий: " .. new_rank .. ")", nil, nil, 20)
end

-- Отнять Ранг
function god_dialog:rank_sub_clicked()
    if not db.actor then return end

    local edit_box = self:GetEditBox("rank_edit_box")
    local text = edit_box:GetText()
    local val = tonumber(text)

    if val == nil then
        local snd1 = sound_object([[detectors\contact_2]])
        snd1:play(db.actor, 0, sound_object.s2d)
        return
    end

    local current_rank = db.actor:character_rank()

    local new_rank = current_rank - val
    if new_rank < 0 then new_rank = 0 end

    db.actor:set_character_rank(new_rank)
    news_manager.send_tip(db.actor, "Уменьшен ранг на: " .. val .. " (текущий: " .. new_rank .. ")", nil, nil, 20)
end


