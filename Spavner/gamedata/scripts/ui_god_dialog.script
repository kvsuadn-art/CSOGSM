function god_dialog:god_mode_full_GetCheck()
    return self.god_mode_full:GetCheck()
end
function god_dialog:god_mode_GetCheck()
    return self.god_mode:GetCheck()
end
function god_dialog:unlimited_ammo_mode_GetCheck()
    return self.unlimited_ammo_mode:GetCheck()
end
function god_dialog:strongman_mode_GetCheck()
    return self.strongman_mode:GetCheck()
end


function god_dialog:update_full_check()
    if  self.god_mode:GetCheck()
    and self.unlimited_ammo_mode:GetCheck()
    and self.strongman_mode:GetCheck()
    then
        self.god_mode_full:SetCheck(true)
    else
        self.god_mode_full:SetCheck(false)
    end
end

-- =======================
--        Обработчики
-- =======================

function god_dialog:god_mode_full_button_clicked()
    if self:god_mode_full_GetCheck() then
        con("g_god on")
        con("g_unlimitedammo on")
        con("g_strongman on")
   
        self.god_mode:SetCheck(true)
        self.unlimited_ammo_mode:SetCheck(true)
        self.strongman_mode:SetCheck(true)
    else
        con("g_god off")
        con("g_unlimitedammo off")
        con("g_strongman off")
 
        self.god_mode:SetCheck(false)
        self.unlimited_ammo_mode:SetCheck(false)
        self.strongman_mode:SetCheck(false)
    end

    local snd = sound_object([[detectors\contact_1]])
    snd:play(db.actor, 0, sound_object.s2d)
end

function god_dialog:god_mode_button_clicked()
    if self:god_mode_GetCheck() then
        con("g_god on")
    else
        con("g_god off")
    end
    self:update_full_check()
    local snd = sound_object([[detectors\contact_1]])
    snd:play(db.actor, 0, sound_object.s2d)
end

function god_dialog:unlimited_ammo_mode_button_clicked()
    if self:unlimited_ammo_mode_GetCheck() then
        con("g_unlimitedammo on")
    else
        con("g_unlimitedammo off")
    end
    self:update_full_check()
    local snd = sound_object([[detectors\contact_1]])
    snd:play(db.actor, 0, sound_object.s2d)
end

function god_dialog:strongman_mode_button_clicked()
    if self:strongman_mode_GetCheck() then
        con("g_strongman on")
    else
        con("g_strongman off")
    end
    self:update_full_check()
    local snd = sound_object([[detectors\contact_1]])
    snd:play(db.actor, 0, sound_object.s2d)
end

-- =======================
--   Служебные функции
-- =======================

function god_dialog:check_game()
    local check = false
    if level.present() and (db.actor ~= nil) and db.actor:alive() then
        check = true
    end
    return check
end

-- ¬Вывод инфы в консоль
function con(msg)
get_console():execute(msg)
end
