--Добавить деньги
function god_dialog:OnButton_add_money_clicked()
    if db.actor then
        edit_box_Br = self:GetEditBox("money_edit_box")
        mon = tonumber(edit_box_Br:GetText())
        if mon ~= nil then
            if mon < 0 then mon = 0 end
            if mon >= 10000000000 then mon = 999999999 end
            if db.actor then
                db.actor:give_money(mon)
                news_manager.send_tip(db.actor,"Добавлено денег: "..mon, nil, nil, 2000)
                self:RefreshMoneyDisplay()
            end
        else
            local snd1 = sound_object([[detectors\contact_2]])
            snd1:play(db.actor, 0, sound_object.s2d)
        end
    end
end

--Отнять деньги
function god_dialog:OnButton_remove_money_clicked()
    if db.actor then
        local actor_money = db.actor:money()
        edit_box_Br = self:GetEditBox("money_edit_box")
        mon = tonumber(edit_box_Br:GetText())
        if mon ~= nil then
            if mon < 0 then mon = 0 end
            actor_money = actor_money - mon
            if actor_money < 0 then actor_money = 0 end
            if db.actor then
                local am = actor_money - db.actor:money()
                db.actor:give_money(am)
                actor_money = actor_money - mon
                if actor_money < 0 then actor_money = 0 end
                news_manager.send_tip(db.actor,"Потеряно денег: "..-am, nil, nil, 2000)
                self:RefreshMoneyDisplay()
            end
        else
            local snd1 = sound_object([[detectors\contact_2]])
            snd1:play(db.actor, 0, sound_object.s2d)
        end
    end
end

function god_dialog:OnListItemClicked()
	if self.list_box:GetSize()==0 then return end
	
	local itm_index			= self.list_box:GetSelectedItem()
	
	local item			= self.list_box:GetItem(itm_index)
	
	self:GetDescription(itm_index)
end

function god_dialog:OnButton_spawnitem_clicked()
    if not self.list_box or self.list_box:GetSize() == 0 then return end

    local index = self.list_box:GetSelectedItem()
    if index == -1 then return end

    local actor = db.actor
    if not actor then return end

    local item = self.list_box:GetItem(index)
    if not item or not item.name then return end

    local sect = item.name:GetText()                 
    local original_mode = item._item_mode or item.mode or mode  
    local dis = tonumber(self.spin and self.spin:GetText()) or 0

    if sect and not string.find(sect, "***", 1, true) then
        local snd = sound_object([[detectors\contact_1]])
        snd:play(actor, 0, sound_object.s2d)
    end

    local pos = actor:position()
    local dir = actor:direction()

    local function spawn_item(section, distance, count)
        count = tonumber(count) or 1
        if count < 1 then count = 1 end
        if count > 1000 then count = 1000 end

        local start_pos = actor:position()
        local fwd = actor:direction()
        local hx, hz = fwd.x, fwd.z
        local len = math.sqrt(hx*hx + hz*hz)
        if len < 1e-3 then hx, hz = 1, 0 else hx, hz = hx/len, hz/len end

        distance = tonumber(distance) or 0
        if distance == 0 then
            for i = 1, count do
                alife():create(section, start_pos, 0, 0, actor:id())
            end
        elseif distance == -1 then
            for i = 1, count do
                alife():create(section, start_pos, actor:level_vertex_id(), actor:game_vertex_id())
            end
        else
            local p = vector():set(
                start_pos.x + hx * distance,
                start_pos.y + 0.2,
                start_pos.z + hz * distance
            )
            for i = 1, count do
                alife():create(section, p, actor:level_vertex_id(), actor:game_vertex_id())
            end
        end
    end

    if original_mode == "item" then
        local count = tonumber(self.count and self.count:GetText()) or 1
        spawn_item(sect, dis, count)
        return
    end

    if original_mode == "npc" then
        local count = tonumber(self.count and self.count:GetText()) or 1
        if count < 1 then count = 1 end
        if count > 50 then count = 50 end

        local fwd = actor:direction()
        local hx, hz = fwd.x, fwd.z
        local len = math.sqrt(hx*hx + hz*hz)
        if len < 1e-3 then hx, hz = 1, 0 else hx, hz = hx/len, hz/len end

        local p
        if dis == -1 then
            p = vector():set(pos.x, pos.y, pos.z)
        else
            local dist = (dis == 0) and 3 or dis
            p = vector():set(
                pos.x + hx * dist,
                pos.y + 0.2,
                pos.z + hz * dist
            )
        end

        for i = 1, count do
            alife():create(sect, p, actor:level_vertex_id(), actor:game_vertex_id())
        end
        return
    end

    if original_mode == "com" then
        actor:set_character_community(sect, 0, 0)
        return
    end

    if original_mode == "snd" then
        local s = sound_object(sect)
        if ui_god_dialog.last_music then
            ui_god_dialog.last_music:stop()
        end
        s:play_at_pos(actor, vector():set(0,0,0), 0, sound_object.s2d)
        ui_god_dialog.last_music = s
        return
    end

    if original_mode == "anom" then
        local actor = db.actor
        if not actor then return end

        local count = tonumber(self.count and self.count:GetText()) or 1
        if count < 1 then count = 1 end
        if count > 50 then count = 50 end

        local pos = actor:position()
        local fwd = actor:direction()
        local hx, hz = fwd.x, fwd.z
        local len = math.sqrt(hx*hx + hz*hz)
        if len < 1e-3 then hx, hz = 1, 0 else hx, hz = hx/len, hz/len end

        local base
        if dis == -1 then
            base = vector():set(pos.x, pos.y, pos.z)
        else
            local dist = (dis == 0) and 3 or dis
            base = vector():set(
                pos.x + hx * dist,
                pos.y + 0.2,
                pos.z + hz * dist
            )
        end

        for i = 1, count do
            spawn_anom(sect, base)
        end
        return
    end

    if original_mode == "weather" then
        local actor = db.actor
        if not actor then return end

        if string.find(sect, "fx_", 1, true) then
            level.set_weather_fx(sect)
            god.save_var("god_weather_fx", true)
        else
            level.set_weather(sect, true)
            god.save_var("god_weather_fx", false)
        end

        god.save_var("god_weather_type", sect)
        return
    end

    if original_mode == "vid" then
        self:OnButton_close_clicked()
        xr_effects.run_tutorial(nil, nil, { sect })
        return
    end
	
	if original_mode == "tlp" then
        self:OnButton_take_from_list_clicked()
        return
    end
	
    if original_mode == "level" then
        local index = self._level_index_by_coords and self._level_index_by_coords[sect]
        if not index then return end
        
        local data = god_tbl.god_level_table[index]
        if not data then return end
        
        local actor = db.actor
        if not actor then return end
        
        local pos2 = actor:position()
        local target_level = data.level
        
        self:OnButton_close_clicked()
        level.add_pp_effector("teleport.ppe", 2006, false)
        
        local pos = vector()
        pos:set(
            data.position[1],
            data.position[2],
            data.position[3]
        )
        
        if level.name() == target_level then
            actor:set_actor_position(pos)
        else
            local lc = god.spawn_lc(actor:game_vertex_id(), pos2, target_level, pos, 0, data.game_vertex)
            god.del_level_changer()
        end
    
        return
    end
end

---------------------------------------------------------------------------

function tf_exp(num)
	local tf, exp = tostring(math.floor(num)), 2
	--for z in string.gmatch(tf, "0") do exp = exp + 1 end 
	exp = string.len(tf) - 1 if exp > 6 then exp = 6 end
	return exp
end

-- from sam_lie
-- Compatible with Lua 5.0 and 5.1.
-- Disclaimer : use at own risk especially for hedge fund reports :-)

---============================================================
-- add comma to separate thousands
-- 
function comma_value(amount)
  local formatted = amount
  while true do  
    formatted, k = string.gsub(formatted, "^(-?%d+)(%d%d%d)", '%1,%2')
    if (k==0) then
      break
    end
  end
  return formatted
end

function god_dialog:OnButton_close_clicked()
	self:GetHolder():start_stop_menu	(self,false)
	self.owner:Show						(true)
	self:ResetTeleportState()
	if level.present() and db.actor and db.actor:alive() then
		get_console():execute("main_menu off")
	end
end


-- Функция кнопки ВПЕРЕД
function god_dialog:OnBtnNext()
    if self.current_page < self.total_pages then
        self.current_page = self.current_page + 1
        self:ShowPage(self.current_page)
    end
end

-- Функция кнопки НАЗАД
function god_dialog:OnBtnPrev()
    if self.current_page > 1 then
        self.current_page = self.current_page - 1
        self:ShowPage(self.current_page)
    end
end

-- Функция отображение нужной страницы
function god_dialog:ShowPage(page_id)
    local all = {
        self.btn_wpn, self.btn_ammo, self.btn_otf, self.btn_food, self.btn_medicines,
        self.btn_art, self.btn_stalker, self.btn_mob, self.btn_level, self.btn_weather,
        self.btn_anom, self.btn_squads, self.btn_other, self.btn_war,
        self.btn_music, self.btn_jokes, self.btn_objects, self.btn_wpn_addons, self.btn_car, self.btn_decor_items
    }
    for _, b in ipairs(all) do if b then b:Show(false) end end

    if page_id == 1 then
        local p1 = {
            self.btn_wpn, self.btn_ammo, self.btn_otf, self.btn_food, self.btn_medicines,
            self.btn_art, self.btn_stalker, self.btn_mob, self.btn_level, self.btn_weather
        }
        for _, b in ipairs(p1) do if b then b:Show(true) end end
        if self.prev_dlg_b then self.prev_dlg_b:Enable(false) end
        if self.next_dlg_b then self.next_dlg_b:Enable(true) end

    elseif page_id == 2 then
        local p2 = {
            self.btn_anom, self.btn_squads, self.btn_other, self.btn_war,
            self.btn_music, self.btn_jokes, self.btn_objects, self.btn_wpn_addons, self.btn_car, self.btn_decor_items
        }
        for _, b in ipairs(p2) do if b then b:Show(true) end end
        if self.prev_dlg_b then self.prev_dlg_b:Enable(true) end
        if self.next_dlg_b then self.next_dlg_b:Enable(false) end
    end
end

