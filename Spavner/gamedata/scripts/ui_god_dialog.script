_G.sys_ini = system_ini()
local translate = game.translate_string
local string_format = string.format
local kScreen = math.min( (1024/768) / (device().width/device().height), 1 )
local function get_inv_name( section, def )
	if sys_ini:section_exist( section ) and sys_ini:line_exist( section, "inv_name" ) then
		return translate( sys_ini:r_string_wq( section, "inv_name" ) )
	end
	return translate( def )
end

-- ==========================
-- Функция получения иконки
-- ==========================
function get_icon(section)
    if god_tbl.god_npc_icons_table[section] then
        local tex = god_tbl.god_npc_icons_table[section]
        local ti = GetTextureInfo(tex, "ui\\ui_npc_unique")
        if ti then
            local r = ti:get_rect()
            return Frect():set(r.x1, r.y1, r.x2, r.y2), "ui\\ui_npc_unique"
        end
    end

    if sys_ini:section_exist(section) and sys_ini:line_exist(section, "inv_grid_x") then
        local x = sys_ini:r_u32(section, "inv_grid_x")*50
        local y = sys_ini:r_u32(section, "inv_grid_y")*50
        local w = sys_ini:r_u32(section, "inv_grid_width")*50
        local h = sys_ini:r_u32(section, "inv_grid_height")*50
        return Frect():set(x, y, x+w, y+h), "ui\\ui_icon_equipment"

    elseif sys_ini:line_exist(section, "icon") then
        local tex = sys_ini:r_string(section, "icon")
        if tex then
            local tex_info
            local file

            if string.sub(tex, 1, 15) == "ui_npc_monster_" then
                tex_info = GetTextureInfo(tex, "ui\\ui_npc_monster")
                file = "ui\\ui_npc_monster"
            else
                tex_info = GetTextureInfo(tex, tex)
                file = tex_info:get_file_name()
            end

            if tex_info then
                local r = tex_info:get_rect()
                return Frect():set(r.x1, r.y1, r.x2, r.y2), file
            end
        end

    -- Заглушка
    else
        return Frect():set(249, 940, 249+83, 940+47), "ui\\ui_iconsTotal"
    end
end

-- ===============================
-- Функция отображения описания 
-- ==============================
function god_dialog:GetDescription(indx)
    local itm = self.list_box:GetItem(indx)
    if itm == nil then
        self.descr:SetText("")
        self.pict:Show(false)
        self.cost:SetText("")
        self.weight:SetText("")
        return
    end

    local sect = itm.name:GetText()
    if not sys_ini:section_exist(sect) then
        self.descr:SetText("")
        self.pict:Show(false)
        self.cost:SetText("")
        self.weight:SetText("")
        return
    end

    -- ==========================
    -- Получаем иконку
    -- ==========================
    local rect, file = get_icon(sect)
    if rect and file then
        local pw = ((rect.x2 - rect.x1)/5)*4*kScreen
        local ph = ((rect.y2 - rect.y1)/5)*4
        local px = -50 + 210-(pw/2)
        local py = 40 + 75-(ph/2)

        self.pict:InitTexture(file)
        self.pict:SetOriginalRect(rect)
        self.pict:SetWndRect(Frect():set(px, py, px + pw, py + ph))
        self.pict:SetStretchTexture(true)
        self.pict:Show(true)
    else
        self.pict:Show(false)
    end

    -- ==============================================
    -- Получаем описание (только текст description)
    -- =============================================
    local description = ""
    if sys_ini:line_exist(sect, "description") then
        local str = sys_ini:r_string_wq(sect, "description")
        if str and str ~= "" then
            description = translate(str)
        end
    end
    self.descr:SetText(description)

    -- ==========================
    -- Цена и вес
    -- ==========================
    if sys_ini:line_exist(sect, "cost") then
        self.cost:SetText(string_format("Цена: %d руб.", sys_ini:r_float(sect, "cost")))
    else
        self.cost:SetText("")
    end
    if sys_ini:line_exist(sect, "inv_weight") then
        self.weight:SetText(string_format("Вес: %.2f кг.", sys_ini:r_float(sect, "inv_weight")))
    else
        self.weight:SetText("")
    end
end
