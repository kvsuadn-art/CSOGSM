-- Меню телепортации 2.0
----------------------------------------------------------------------------------------------------
-- Открыть меню телепортации
function god_dialog:OnButton_portal_clicked()
    local teleportFile = "gamedata\\configs\\misc\\god_teleports_coordinats.ltx"

    if not self.dialog then
        printf("ERROR: dialog not initialized")
        return
    end

    if self.list_box then
        self.list_box:RemoveAll()
    end

    self.dialog:Show(true)
    self.god_comand:Show(false)
    self.btn_portal:Show(false)
    self.hud_btn:Show(false)
    self.btn_replenish_health:Show(false)
    self.btn_get_money:Show(false)
    self.btn_equipment_repair:Show(false)
	self.btn_cleaner_menu:Show(false)
    self.jump_forward_edit_box:Show(false)
    self.btn_jump_forward:Show(false)
    self.btn_jump_return:Show(false)
    self.rank_edit_box:Show(false)
    self.btn_rank_add:Show(false)
    self.btn_rank_sub:Show(false)

    mode = "tlp"
	
	god.del_level_changer()

    if self.search_all then
        self.search_all:SetCheck(false)
        self.search_all:Enable(false)
    end

    local file = io.open(teleportFile, "r")
    if not file then
        printf("No teleport file found: %s", teleportFile)
        return
    end

    for line in file:lines() do
        local parts = str_explode("|", line)
        if #parts >= 4 then
            local name = parts[1]
            local x = parts[2]
            local y = parts[3]
            local z = parts[4]

            local coord_text = string.format("%s, %s, %s", x, y, z)

            self:AddItemToList(name, coord_text, "tlp", line)
        end
    end

    file:close()
end

-- Взять из списка
function god_dialog:OnButton_take_from_list_clicked()
    if not self.list_box or self.list_box:GetSize() == 0 then return end

    local idx = self.list_box:GetSelectedItem()
    if idx == -1 then return end

    local item = self.list_box:GetItem(idx)
    if not item then return end

    local raw = item.raw
    if not raw then return end

    local parts = str_explode("|", raw)

    self.edit_point_name:SetText(parts[1] or "")
    self.edit_coord_x:SetText(parts[2] or "")
    self.edit_coord_y:SetText(parts[3] or "")
    self.edit_coord_z:SetText(parts[4] or "")
end

-- Позиция ГГ
function god_dialog:OnButton_get_actor_pos_clicked()
    local pos = db.actor:position()
	
    self.edit_coord_x:SetText(string.format("%.3f", pos.x))
    self.edit_coord_y:SetText(string.format("%.3f", pos.y))
    self.edit_coord_z:SetText(string.format("%.3f", pos.z))
end

-- Сохранить точку
function god_dialog:OnButton_save_point_clicked()
    local name = tostring(self.edit_point_name:GetText())
    if name == "" then return end

    local pos = db.actor:position()

    local x = pos.x
    local y = pos.y
    local z = pos.z

    local level_name = level.name()
    local gv = db.actor:game_vertex_id()
    local lv = db.actor:level_vertex_id()

    local file = io.open(self.teleportFile, "a")
    if file then
        file:write(string.format("%s|%.3f|%.3f|%.3f|%s|%d|%d\n", name, x, y, z, level_name, gv, lv))
          
        file:close()
    end

    self:OnButton_portal_clicked()
end

-- Удалить точку
function god_dialog:OnButton_delete_point_clicked()
    if not self.list_box or self.list_box:GetSize() == 0 then return end

    local idx = self.list_box:GetSelectedItem()
    if idx == -1 then return end

    local item = self.list_box:GetItem(idx)
    if not item then return end

    local raw = item.raw
    if not raw then return end

    local lines = {}
    for line in io.lines(self.teleportFile) do
        if line ~= raw then
            table.insert(lines, line)
        end
    end

    local f = io.open(self.teleportFile, "w")
    if f then
        for _, l in ipairs(lines) do
            f:write(l .. "\n")
        end
        f:close()
    end

    self:OnButton_portal_clicked()
end

-- Телепорт
function god_dialog:OnButton_teleport_point_clicked()
    local x = tonumber(self.edit_coord_x:GetText())
    local y = tonumber(self.edit_coord_y:GetText())
    local z = tonumber(self.edit_coord_z:GetText())
    if not x or not y or not z then return end

    local pos = vector():set(x, y, z)

    local idx = self.list_box:GetSelectedItem()
    if idx == -1 then return end

    local item = self.list_box:GetItem(idx)
    if not item then return end

    local raw = item.raw
    if not raw then return end

    local parts = str_explode("|", raw)

    local level_name = parts[5] or level.name()

    level.add_pp_effector("teleport.ppe", 2006, false)

    self:OnButton_close_clicked()
	self:ResetTeleportState()

    if level_name == level.name() then
        db.actor:set_actor_position(pos)
    else
        local gv2 = db.actor:game_vertex_id()
        local pos2 = db.actor:position()
        local target_gv = tonumber(parts[6]) or gv2

        local lc = god.spawn_lc(gv2, pos2, level_name, pos, 1, target_gv)
        god.del_level_changer()
    end
end

-- Переключения раскладки РУС/ENG
function god_dialog:OnButton_lang_name_point_clicked()
	self.lang_mode_point = not self.lang_mode_point
	self.btn_lang_point:SetText(self.lang_mode_point and "РУС" or "ENG")
end

function god_dialog:OnChangeEditText_point()
    if self._changing_text then return end
    self._changing_text = true

    local text = self.edit_point_name:GetText() or ""
    local len_l = #self.last_text
    local len_t = #text
    local s = ""

    for i = 1, len_t do
        local ch = text:sub(i,i)
        local prev = self.last_text:sub(i,i)

        if i > len_l or ch ~= prev then
            if self.lang_mode_point then
                if translit_tbl[ch] then
                    s = s .. translit_tbl[ch]
                else
                    local eng = reversed_tbl[ch]
                    if eng and translit_tbl[eng] then
                        s = s .. translit_tbl[eng]
                    else
                        s = s .. ch
                    end
                end
            else
                if reversed_tbl[ch] then
                    s = s .. reversed_tbl[ch]
                else
                    s = s .. ch
                end
            end
        else
            s = s .. prev
        end
    end

    self.last_text = s

    if self.edit_point_name:GetText() ~= s then
        self.edit_point_name:SetText(s)
    end

    self.was_found = -1
    self._changing_text = nil
end

-- Удалить текст из поля имени точки
function god_dialog:OnButton_clear_name_point_clicked()
	self.edit_point_name:SetText("")
	self.was_found = -1
end

-- Закрыть меню
function god_dialog:OnButton_exit_point_clicked()
    if self.dialog then
	    self.list_box:RemoveAll()
		god.del_level_changer()
        self.dialog:Show(false)
	    self.god_comand:Show(true)
	    self.btn_portal:Show(true)
	    self.hud_btn:Show(true)
	    self.btn_replenish_health:Show(true)
	    self.btn_get_money:Show(true)
	    self.btn_equipment_repair:Show(true)
		self.btn_cleaner_menu:Show(true)
	    self.jump_forward_edit_box:Show(true)
	    self.btn_jump_forward:Show(true)
	    self.btn_jump_return:Show(true)
        self.rank_edit_box:Show(true)
	    self.btn_rank_add:Show(true)
	    self.btn_rank_sub:Show(true)
		self:ResetTeleportState()
    end
end

-- Сброс состояния меню телепортов и восстановление чекбокса поиска
function god_dialog:ResetTeleportState()
    if self.search_all then
        self.search_all:Enable(true)
        if self._prev_search_all_state ~= nil then
            self.search_all:SetCheck(self._prev_search_all_state)
            self._prev_search_all_state = nil
        end
    end

    mode = nil
end

-- Отключить Худ
function god_dialog:OnButton_hud_clicked()
    if not db.actor then return end

    local hud_state = god.load_var("hud_state", true)

    if hud_state == true then
        level.hide_indicators_safe()
        god.save_var("hud_state", false)
        self.hud_btn:SetText("Включить Худ")
    else
        level.show_indicators()
        god.save_var("hud_state", true)
        self.hud_btn:SetText("Отключить Худ")
    end
end

