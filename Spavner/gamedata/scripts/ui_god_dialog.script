-- File:        UI_god_DIALOG.SCRIPT
-- Description: Cheat Dialog for STALKER

local mode -- Режим спауна
local eng = [[qwertyuiop[]asdfghjkl;'zxcvbnm,./QWERTYUIOP{}ASDFGHJKL:"ZXCVBNM<>?!@#$%^&*()-_+=\| 0123456789]]
local rus = [[йцукенгшщзхъфывапролджэячсмитьбю.ЙЦУКЕНГШЩЗХЪФЫВАПРОЛДЖЭЯЧСМИТЬБЮ,!"№;%:?*()-_+=\/ 0123456789]]

local translit_tbl = {}   -- eng -> rus
local reversed_tbl  = {}   -- rus -> eng (обратная)
for i = 1, math.min(#eng, #rus) do
    local e = eng:sub(i,i)
    local r = rus:sub(i,i)
    translit_tbl[e] = r
    reversed_tbl[r] = e
end

local function translit_char(c)
    return translit_tbl[c] or c
end


local RU_LOWER = {
    ["А"]="а", ["Б"]="б", ["В"]="в", ["Г"]="г", ["Д"]="д", ["Е"]="е", ["Ё"]="ё", ["Ж"]="ж",
    ["З"]="з", ["И"]="и", ["Й"]="й", ["К"]="к", ["Л"]="л", ["М"]="м", ["Н"]="н", ["О"]="о",
    ["П"]="п", ["Р"]="р", ["С"]="с", ["Т"]="т", ["У"]="у", ["Ф"]="ф", ["Х"]="х", ["Ц"]="ц",
    ["Ч"]="ч", ["Ш"]="ш", ["Щ"]="щ", ["Ъ"]="ъ", ["Ы"]="ы", ["Ь"]="ь", ["Э"]="э", ["Ю"]="ю", ["Я"]="я",
}

local function clean_name(s)
    if not s then return "" end
    s = string.gsub(s, "c%[[^%]]+%]", "")
    return s
end
local function lower_any(s)
    if not s then return "" end
    s = clean_name(s)
    s = string.lower(s) -- латиница в нижний регистр
    s = string.gsub(s, "[А-ЯЁ]", function(ch) return RU_LOWER[ch] or ch end) -- кириллица в нижний
    return s
end

local function is_checked(ctrl)
    if not ctrl then return false end
    if ctrl.GetCheck then return ctrl:GetCheck() == true end
    if ctrl.IsChecked then return ctrl:IsChecked() == true end
    return false
end

class "god_item" (CUIListItemEx)

function god_item:__init() super()
	self.item_name		= "itemname"
	
	local ca = 255
	local cr = 216
	local cg = 186
	local cb = 140
	
	self.dn					= CUIStatic	()
	self.dn:SetAutoDelete	(true)
	self:AttachChild		(self.dn)
	self.dn:SetWndRect		(Frect():set(0,0,280,22))
	self.dn:SetFont			(GetFontLetterica18Russian())
	self.dn:SetTextColor	(ca,cr,cg,cb)

	self.name				= CUIStatic	()
	self.name:SetAutoDelete	(true)
	self:AttachChild		(self.name)
	self.name:SetWndRect	(Frect():set(290,0,250+110,22))
	self.name:SetText		(sect)
	self.name:SetFont		(GetFontLetterica16Russian())
	self.name:SetTextColor	(ca,cr,cg,cb)
end


class "god_dialog" (CUIScriptWnd)

function god_dialog:__init() super()
   self:InitControls()
   self:InitCallBacks()
   self.lang_mode        = true
   self.lang_mode_point  = true
   self.last_text        = ""
   self.current_page     = 1
   self.total_pages      = 2 
   self:ShowPage(self.current_page)   
end
              
