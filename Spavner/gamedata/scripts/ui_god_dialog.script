function god_dialog:AddItemToList(item_dispname, item_name, original_mode, raw)
    local _itm = god_item()
    _itm.dn:SetText(item_dispname)
    _itm.name:SetText(item_name)
	
	_itm.raw = raw

    -- Запоминаем реальный раздел (важно для спавна при включённом чекбоксе)
    _itm._item_mode = original_mode or mode

    self:GetListWnd("list_window"):AddItem(_itm)
end

local kAlt = {[DIK_keys.DIK_LMENU]=true,[DIK_keys.DIK_RMENU]=true}
local kShift = {[DIK_keys.DIK_LSHIFT]=true,[DIK_keys.DIK_RSHIFT]=true}

function god_dialog:OnKeyboard(dik, keyboard_action)
    CUIScriptWnd.OnKeyboard(self, dik, keyboard_action)

    local bind = dik_to_bind(dik)
    if bind == key_bindings.kQUIT then
        self:OnButton_close_clicked()
    else
        if keyboard_action == ui_events.WINDOW_KEY_PRESSED then

            if kAlt[dik] then self.alt_pressed = true
            elseif kShift[dik] then self.shift_pressed = true
            end

            if (self.shift_pressed and kAlt[dik]) or (self.alt_pressed and kShift[dik]) then
                self:OnBtnChangeLanguage()
            end

            if dik == DIK_keys.DIK_DELETE then
                self:OnBtnClearText()
            end

            if dik == DIK_keys.DIK_RETURN then
                self:OnButton_spawnitem_clicked()
            elseif dik == DIK_keys.DIK_Q then
                if self.current_page > 1 then
                    self:OnBtnPrev()
                end
            elseif dik == DIK_keys.DIK_E then
                if self.current_page < self.total_pages then
                    self:OnBtnNext()
                end
            elseif dik == DIK_keys.DIK_TAB then
                self:OnBtnShowDescr()
            end

        elseif keyboard_action == ui_events.WINDOW_KEY_RELEASED then
            if kAlt[dik] then self.alt_pressed = nil
            elseif kShift[dik] then self.shift_pressed = nil
            end
        end
    end

    return true
end


-- Спауним аномалию
function spawn_anom(item,pos)

local obj = alife():create(item,pos,db.actor:level_vertex_id(),db.actor:game_vertex_id())
    if string.find(obj:section_name(), "zone_mine_gravitational") or
       string.find(obj:section_name(), "field") or 
       string.find(obj:section_name(), "teleport") or
       string.find(obj:section_name(), "death") or  
       string.find(obj:section_name(), "sarcofag") or  
       string.find(obj:section_name(), "zone_radioactive") then
     anom.create_anom(obj,3, pos, db.actor:level_vertex_id(), db.actor:game_vertex_id(),"field")
       else
     anom.create_anom(obj,3, pos, db.actor:level_vertex_id(), db.actor:game_vertex_id())
end
end

function str_explode(div,str,pos1,pos2,clear)
	local t={}
	local cpt, pos

	if pos1 == nil then pos1 = 1 end
	if pos2 == nil then pos2 = pos1 end

	local cpt1 = string.find (str, div, pos1, true)
	local cpt2 = string.find (str, div, pos2, true)

	if cpt1 and cpt2 then

		if cpt2-cpt1 > 5 then
			cpt = cpt1
			pos = pos1
		else
			cpt = cpt2
			pos = pos2
		end

		repeat
			if clear then
				table.insert( t, trim(string.sub(str, 1, cpt-1)) )
			else
				table.insert( t, string.sub(str, 1, cpt-1) )
			end
			str = string.sub( str, cpt+string.len(div) )
			cpt = string.find (str, div, pos, true)
		until cpt==nil
	end
	if clear then
		table.insert(t, trim(str))
	else
		table.insert(t, str)
	end
	return t
end
-----------------------------------------------------------Поиск---------------------------------------------------------------------------------------------------------------------------------
-- Поиск с поддержкой «искать везде» + имена для всех разделов (включая локации)
function god_dialog:OnSearchTextChanged()
    if not self.search_edit_box or not self.list_box then return end

    local function get_item_name(sect)
        local ini = system_ini()
        local raw = (ini:line_exist(sect, "inv_name") and ini:r_string(sect, "inv_name")) or sect
        return game.translate_string(raw)
    end

    local q = lower_any(self.search_edit_box:GetText() or "")
	
	if mode == "tlp" then
        self.list_box:RemoveAll()

        local file = io.open("gamedata\\configs\\misc\\god_teleports_coordinats.ltx", "r")
        if not file then return end

        for line in file:lines() do
            local parts = str_explode("|", line)
            if #parts >= 7 then
                local name = parts[1] or ""
                local x = parts[2] or ""
                local y = parts[3] or ""
                local z = parts[4] or ""
                local level = parts[5] or ""

                local full = lower_any(
                    name .. " " ..
                    x .. " " .. y .. " " .. z .. " " ..
                    level
                )

                if q == "" or string.find(full, q, 1, true) then
                    local coord_text = string.format("%s, %s, %s", x, y, z)

                    self:AddItemToList(name, coord_text, "tlp", line)
                end
            end
        end

        file:close()
        return 
    end
	
    self.list_box:RemoveAll()

    local search_everywhere = is_checked(self.search_all)
    if search_everywhere then
        self:EnsureAllByMode()
    end

    local pool = {}
    if search_everywhere and type(self.all_by_mode) == "table" then
        local seen = {}
        for _, pack in pairs(self.all_by_mode) do
            if type(pack) == "table" and type(pack.list) == "table" then
                for _, sect in ipairs(pack.list) do
                    if sect and not seen[sect] then
                        table.insert(pool, { sect = sect, mode = pack.mode })
                        seen[sect] = true
                    end
                end
            end
        end
    else
        if self.all_items then
            for _, sect in ipairs(self.all_items) do
                table.insert(pool, { sect = sect, mode = mode })
            end
        end
    end

    for _, entry in ipairs(pool) do
        local sect = entry.sect

        local name = nil

        if entry.mode == "level" and self._level_name_by_section then
            local index = self._level_name_by_section[sect]
            if index and god_tbl.god_level_table[index] then
                local data = god_tbl.god_level_table[index]
                name = data.name .. " | " ..
                    string.format("%.2f %.2f %.2f", 
                        data.position[1], data.position[2], data.position[3]
                    )
            end
        end
		
        name = name or
            (self._npc_name_by_section     and self._npc_name_by_section[sect])     or
            (self._mob_name_by_section     and self._mob_name_by_section[sect])     or
            (self._car_name_by_section     and self._car_name_by_section[sect])     or 
			(self._decor_name_by_section   and self._decor_name_by_section[sect])   or
            (self._level_name_by_section   and self._level_name_by_section[sect])   or
            (self._weather_name_by_section and self._weather_name_by_section[sect]) or
            (self._anom_name_by_section    and self._anom_name_by_section[sect])    or
            (self._com_name_by_section     and self._com_name_by_section[sect])     or
            (self._vid_name_by_section     and self._vid_name_by_section[sect])     or
            (self._music_name_by_section   and self._music_name_by_section[sect])   or
            (self._jokes_name_by_section   and self._jokes_name_by_section[sect])   or
            get_item_name(sect)

        if q == "" or
           string.find(lower_any(name), q, 1, true) or
           string.find(lower_any(sect), q, 1, true) then
           self:AddItemToList(name, sect, entry.mode)
        end
    end
end

-- Унифицированный сбор «всех разделов» для чекбокса
function god_dialog:EnsureAllByMode()
    local function safe_collect(tbl, has_names, m)
        local t, dict = {}, {}
        if type(tbl) == "table" then
            if has_names then
                for _, v in ipairs(tbl) do
                    local sect = v and v[1]
                    if sect then
                        table.insert(t, sect)
                        dict[sect] = v[2] or sect
                    end
                end
            else
                for _, sect in ipairs(tbl) do
                    if sect then table.insert(t, sect) end
                end
            end
        end
        return { list = t, mode = m, dict = dict }
    end

    local function safe_collect_name_first(tbl, m)
        local t, dict = {}, {}
        if type(tbl) == "table" then
            for _, v in ipairs(tbl) do
                local name, sect = v[1], v[2]
                if sect then
                    table.insert(t, sect)
                    dict[sect] = name or sect
                end
            end
        end
        return { list = t, mode = m, dict = dict }
    end

    self:BuildLevelIndexIfNeeded()

    self.all_by_mode = {
        wpn        = safe_collect(god_tbl.god_weapons_table           or {}, false, "item"),
        ammo       = safe_collect(god_tbl.god_ammo_table              or {}, false, "item"),
        otf        = safe_collect(god_tbl.god_outfits_table           or {}, false, "item"),
        food       = safe_collect(god_tbl.god_food_table              or {}, false, "item"),
		medicines  = safe_collect(god_tbl.god_medicines_table         or {}, false, "item"),
        art        = safe_collect(god_tbl.god_artefacts_table         or {}, false, "item"),
        npc        = safe_collect(god_tbl.god_stalker_table           or {}, true,  "npc"),
        mob        = safe_collect(god_tbl.god_mob_table               or {}, true,  "npc"),
        car        = safe_collect(god_tbl.god_car_table               or {}, true,  "npc"),
        decor      = safe_collect(god_tbl.god_decor_items_table       or {}, true,  "npc"), 
        level      = safe_collect(self._levels_list                   or {}, true,  "level"),
        weather    = safe_collect(god_tbl.god_weather_table           or {}, true,  "weather"),
        anom       = safe_collect(god_tbl.god_anom_table              or {}, true,  "anom"),
        com        = safe_collect(god_tbl.god_community_table         or {}, true,  "com"),
        other      = safe_collect(god_tbl.god_other_table             or {}, false, "item"),
        objects    = safe_collect(god_tbl.god_info_table              or {}, false, "item"),
        wpn_addons = safe_collect(god_tbl.god_wpn_addons_table        or {}, false, "item"),
        vid        = safe_collect(god_tbl.god_vid_table               or {}, true,  "vid"),
        music      = safe_collect_name_first(god_tbl.god_music_table  or {}, "snd"),
        jokes      = safe_collect_name_first(god_tbl.god_jokes_table  or {}, "snd"),
    }

    self._npc_name_by_section     = self.all_by_mode.npc.dict
    self._mob_name_by_section     = self.all_by_mode.mob.dict
    self._car_name_by_section     = self.all_by_mode.car.dict
    self._decor_name_by_section   = self.all_by_mode.decor.dict 
    self._level_name_by_section   = self.all_by_mode.level.dict
    self._weather_name_by_section = self.all_by_mode.weather.dict
    self._anom_name_by_section    = self.all_by_mode.anom.dict
    self._com_name_by_section     = self.all_by_mode.com.dict
    self._vid_name_by_section     = self.all_by_mode.vid.dict
    self._music_name_by_section   = self.all_by_mode.music.dict
    self._jokes_name_by_section   = self.all_by_mode.jokes.dict
end

function god_dialog:OnChangeEditText()
    if self._changing_text then return end
    self._changing_text = true

    local text = self.search_edit_box:GetText() or ""
    local len_l = #self.last_text
    local len_t = #text
    local s = ""

    for i = 1, len_t do
        local ch = text:sub(i,i)
        local prev = self.last_text:sub(i,i)

        if i > len_l or ch ~= prev then
            if self.lang_mode then
                if translit_tbl[ch] then
                    s = s .. translit_tbl[ch]
                else
                    local eng = reversed_tbl[ch]
                    if eng and translit_tbl[eng] then
                        s = s .. translit_tbl[eng]
                    else
                        s = s .. ch
                    end
                end
            else
                if reversed_tbl[ch] then
                    s = s .. reversed_tbl[ch]
                else
                    s = s .. ch
                end
            end
        else
            s = s .. prev
        end
    end

    self.last_text = s

    if self.search_edit_box:GetText() ~= s then
        self.search_edit_box:SetText(s)
    end

    self.was_found = -1
    self._changing_text = nil
end

function god_dialog:Update()
    CUIScriptWnd.Update(self)
	
	if self._changing_text then return end
	
    local check = is_checked(self.search_all)
    if check ~= self._search_all_prev then
        self._search_all_prev = check
        self:OnSearchTextChanged()
    end

    if self.search_edit_box then
        local text = self.search_edit_box:GetText() or ""
        if text ~= self._last_search_text then
            self._last_search_text = text
            self:OnChangeEditText()
			
            self:OnSearchTextChanged()
        end
    end

    if self.edit_point_name then
        local text = self.edit_point_name:GetText() or ""
        if text ~= self._last_point_text then
            self._last_point_text = text
			
            self:OnChangeEditText_point()
        end
    end
end

function god_dialog:OnBtnClearText()
	self.search_edit_box:SetText("")
	self.was_found = -1
end

function god_dialog:OnBtnChangeLanguage()
	self.lang_mode = not self.lang_mode
	self.btn_lang:SetText(self.lang_mode and "РУС" or "ENG")
end

-- Построение списка локаций
function god_dialog:BuildLevelIndexIfNeeded()
    if self._levels_list and self._level_name_by_section and self._level_index_by_coords then
        return
    end

    self._levels_list = {}
    self._level_name_by_section = {}
    self._level_index_by_coords = {}
	if god.del_level_changer then god.del_level_changer() end

    for i, data in ipairs(god_tbl.god_level_table or {}) do

        local level_disp = ""
		
        if data.game_vertex then
            local vertex = game_graph():vertex(data.game_vertex)
            if vertex then
                local lvl_id = vertex:level_id()
                level_disp = game.translate_string(
                    alife():level_name(lvl_id)
                )
            end
        end

        local coords =
            tostring(data.position[1]) .. " " ..
            tostring(data.position[2]) .. " " ..
            tostring(data.position[3])

        local disp = level_disp .. " (" .. data.name .. ")"

        table.insert(self._levels_list, {coords, disp})
        self._level_name_by_section[coords] = disp
        self._level_index_by_coords[coords] = i
    end
end
