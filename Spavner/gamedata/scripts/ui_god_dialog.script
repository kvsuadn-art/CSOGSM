----------------------
--//Прыжок  Вперёд
---------------------
function god_dialog:jump_forward_clicked()
    if not db.actor then return end

    local edit_box = self:GetEditBox("jump_forward_edit_box")

    local text = edit_box:GetText()
    if string.len(text) > 3 then
        text = string.sub(text, 1, 3) 
        edit_box:SetText(text)
    end

    local val = tonumber(text)
    if val == nil then
        local snd1 = sound_object([[detectors\contact_2]])
        snd1:play(db.actor, 0, sound_object.s2d)
        return
    end

    if val > 999 then
        val = 999
        edit_box:SetText("999")
    end

    db.actor:set_actor_position(device().cam_pos:add(device().cam_dir:mul(val)))
    news_manager.send_tip(db.actor, "Прыжок вперёд на: " .. val .. " метров", nil, nil, 5)
end

-----------------------------------------------------------------------
--//Возврат на поверхность геометрии
-----------------------------------------------------------------------
function god_dialog:OnButton_jump_return_clicked() 
	local pos_lvid = level.vertex_position(db.actor:level_vertex_id())
	db.actor:set_actor_position(pos_lvid)
    local snd = sound_object([[detectors\contact_1]])
    snd:play(db.actor, 0, sound_object.s2d)
end

