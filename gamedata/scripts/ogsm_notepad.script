-- Êîëáıê íà ïîëó÷åíèå èíôî
function send_article(group, name)

	local news_caption = ""

 	if group == "Journal" then news_caption = "Ëè÷íàÿ çàìåòêà:"
 	elseif group == "Mutants" then news_caption = "Çàìåòêà î ìóòàíòå:"
	elseif group == "Locations" then news_caption = "Çàìåòêà î ëîêàöèè:"
	elseif group == "Factions" then news_caption = "Çàìåòêà î ãğóïïèğîâêå:"
	elseif group == "Stories" then news_caption = "Ëåãåíäà Çîíû:"
	elseif group == "Anomalies" then news_caption = "Çàìåòêà îá àíîìàëèè:"
	elseif group == "Documents" then news_caption = "Ñåêğåòíûé äîêóìåíò:"
	end

	local news_text = game.translate_string(name)
	db.actor:give_game_news(news_caption, news_text, "ui_iconsTotal_storyline", 0, 5000, 1)
	local pda_news = sound_object([[device\pda\pda_tip]])
	pda_news:play(db.actor, 0, sound_object.s2d)
	if group == "Journal" or group == "Documents" then ogsm.autosave(name) end

end

