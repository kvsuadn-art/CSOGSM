-- Использование рации
function use_radio(pid)

local snd
local i
local length

if alife():object(pid)==nil then
	db.actor:give_info_portion("addon_system_item_active")
	if level.name() == "agroprom_underground" then
		snd = sound_object([[items\radio\radio_noise_2]])
		length = snd:length()
	else
		if math.random()<0.45 then
			i = math.random(1,12)
			snd = sound_object("items\\radio\\radio_voice_"..i)
			length = snd:length()
		else
			i = math.random(1,2)
			snd = sound_object("items\\radio\\radio_noise_"..i)
			length = snd:length()
		end
	end
	if not snd:playing() then
		snd:play_no_feedback(db.actor,sound_object.s2d, 0, vector():set(0, 0, 0), 1.0)
	end
	ogsm.start_timer("spw", length/1000, "hand_radio")
end

end


-- Использование записной книжки
function use_notepad(pid)

if alife():object(pid)==nil then
	local spwn = ogsm_notepad.notepad(get_hud())
	level.start_stop_menu(spwn, true)
	ogsm.spawn_item_in_inv("notepad")
end

end


