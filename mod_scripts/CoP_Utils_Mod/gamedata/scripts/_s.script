--[[---------------------------------------------------------------
--// Разные функции...
--]]---------------------------------------------------------------
--[[
--	По айди указаной строки транслитит ее
--	@param	string	sId	айди строки 
--]]
function GetString(sId)
	if not sId then return "" end
	return game.translate_string(sId)
end
--[[---------------------------------------------------------------
--// Логовые функции, нужны для дебага TODO в релиз не совать
--]]---------------------------------------------------------------
function _log(sName,...)
	local bDbg = ReadVar("debug_mode",tDbgVal["debug_mode"]) 		-- включен ли дебаг-режим вообще
	if bDbg then
		local cLog = ReadVar("in_con",tDbgVal["in_con"]) 			-- выдавать ли лог в консоль
		local sNews = ReadVar("in_news",tDbgVal["in_news"]) 		-- выдавать ли лог в новость
		local fPrint = ReadVar("file_print",tDbgVal["file_print"]) 	-- сохранять ли лог в файл
		if not sName then
			sName = "Nil"
		end
		local sText
		if ... then
			sText = string.format("_log:->:"..sName, ...)
		else
			sText = "_log:->:"..sName
		end
		if sNews then
			if sName~="Nil" then
				local sFind = string.find(sText,"=")
				if sFind then
					sName = string.sub(sText, 1, sFind-1)
				else
					sName = string.sub(sText, 1, 250)
				end
			end
			SendTip(sText,sName,nil,10,"pda")
		end
		if fPrint then
			this._lInFile(sText)
		end
		if cLog and get_console() then
			get_console():execute("load ~~~ "..sText)
		end
	end
end

local fLog = true --первый ли лог с начала текущей игры
function _lInFile(lText)
	local op = io.open("gamedata\\_log.txt", "a")
	if op ~= nil then
		if fLog then
			lText="\n"..lText
			fLog=false
		end
		op:write(tostring(lText).."\n")
		op:close()
	end
end
--[[ ----------------------------------------------------------
--/                           Типсы
--]] ----------------------------------------------------------
local tIcons = {
	default		= "ui_iconsTotal_grouping",
	pda			= "ui_inGame2_PD_Torgovets_informatsiey"
}
--/---------------------------------------------------------------------------
--/показываем типс
function SendTip(nText, nHeader, tOut, tShow, iSender, pSnd)
	if not nText then return end
	if not nHeader then nHeader = GetString("st_tip") end
	if not tOut then tOut = 0 end
	if not tShow then tShow = 5 end
  
	local sObj
	if pSnd=="news" then 
		sObj=sound_object([[device\pda\pda_news]])
	elseif pSnd=="task" then 
		sObj=sound_object([[device\pda\pda_objective]])
  	else 
		sObj=sound_object([[device\pda\pda_tip]])
  	end   

    --' Играем дефолтный звук
  	sObj:play(db.actor,tOut,sound_object.s2d)

  	if not iSender then
    	iSender = "default"
  	end
  	local UiSender = tIcons[iSender]
  	local nText = "%c[default]"..nText
  	
  	if not UiSender then
  		UiSender = iSender
  	end

	if db.actor and UiSender then
		db.actor:give_game_news(nHeader, GetString(nText), UiSender, tOut*1000, tShow*1000)
  	end
	return true
end

--[[-------------------------------------------------------------------------
--/ Интеграция синонимов функций из текущего скрипта в _g.script(tnx Artos)
--]]-------------------------------------------------------------------------
local bFuncG = false

if not bFuncG then
	local tFuncG = {
		["WriteVar"] 		= WriteVariable,
		["ReadVar"] 		= ReadVariable,
		["DelVar"] 			= DelVariable,
		--
		["GetString"] 		= GetString,
		--
		["_log"]			= _log,
		--
		["SendTip"] 		= SendTip
	}
	local oModule = _G
	setfenv(1,oModule)
	for k,v in pairs(tFuncG) do
		oModule[k] = v
		setfenv(oModule[k],oModule)
	end
	bFuncG = true
end
